# Adresse /exec du script Apps Script deploye en application web.
# Reste cote serveur : le navigateur ne la voit jamais.
INSCRIPTION_WEBAPP_URL=

# Secret partage avec le script. DOIT etre identique a la propriete de
# script « SECRET » du classeur maitre. Sans lui, le script refuse
# toute ecriture.
INSCRIPTION_SECRET=

# FACULTATIF — la base secondaire, un second classeur tenu par un autre
# compte, qui recoit une copie de chaque inscription. Adresse /exec de
# SON script (sheets/base-secondaire.gs). Laisser vide desactive la
# copie ; une copie qui echoue n'empeche jamais une inscription.
# Son script utilise le MEME secret : la propriete « SECRET » de son
# projet Apps Script prend la valeur d'INSCRIPTION_SECRET ci-dessus.
INSCRIPTION_MIROIR_URL=

# FACULTATIF — seulement si la base secondaire doit avoir un secret
# different de celui du registre maitre.
INSCRIPTION_MIROIR_SECRET=

# Invitation au groupe WhatsApp, affichee sur l'ecran de confirmation.
# Inseree dans le site AU MOMENT DU BUILD : la changer chez l'hebergeur
# demande de redeployer le site. A garder identique a « Lien CTA »
# dans l'onglet config du classeur.
NEXT_PUBLIC_LIEN_WHATSAPP=

# Date et heure vers lesquelles pointe le compte a rebours de l'accueil,
# au format ISO avec le decalage horaire (Benin : +01:00). Inseree AU
# MOMENT DU BUILD : redeployer le site apres un changement.
NEXT_PUBLIC_DATE_NTMS=2026-11-18T09:00:00+01:00

# FACULTATIF — cloture du formulaire d'inscription, si elle doit
# tomber avant le debut de l'edition. Sans elle, le formulaire ferme
# quand le compte a rebours atteint zero.
NEXT_PUBLIC_FIN_INSCRIPTIONS=

# FACULTATIF — cloture de la billetterie. Entre les deux dates, le
# formulaire est clos mais on peut encore regler sa place.
NEXT_PUBLIC_FIN_PAIEMENTS=

# ---------------------------------------------------------------
# BILLETTERIE — Money Fusion (mobile money)
# ---------------------------------------------------------------

# Adresse d'API de l'application, donnee par le tableau de bord Money
# Fusion. Il n'y a PAS de cle dans les en-tetes : c'est cette adresse
# qui autorise l'appel, donc elle ne doit jamais atteindre le
# navigateur. Tant qu'elle est vide, /paiement repond 404.
MONEYFUSION_API_URL=

# Montant de la place, en FCFA. Lu cote serveur et jamais saisi dans
# le formulaire. Money Fusion impose plus de 200 F.
MONTANT_INSCRIPTION=

# Adresse publique du site, pour bâtir l'adresse de retour et celle du
# webhook. Sans elle, le site donnerait a Money Fusion l'adresse
# interne du deploiement, qui change a chaque build.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------

# FACULTATIF, MISE AU POINT — « 1 » fait remonter jusqu'au navigateur
# le motif exact d'un refus du classeur. A NE JAMAIS laisser allume
# une fois les inscriptions ouvertes au public.
INSCRIPTION_DEBUG=

# FACULTATIF — les six dernieres publications Instagram par l'API
# Graph. Sans jeton, la section affiche la liste tenue a la main dans
# src/lib/instagram.ts.
INSTAGRAM_TOKEN=
